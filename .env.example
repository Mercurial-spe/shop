# Copy this file to .env before running Docker Compose:
#   cp .env.example .env
# Then change the passwords and optional SMTP settings.

MYSQL_DATABASE=shop_db
MYSQL_USER=shop_user
MYSQL_PASSWORD=change-me-shop-pass
MYSQL_ROOT_PASSWORD=change-me-root-pass

# Host port for the frontend Nginx container.
FRONTEND_PORT=5173

# Order email notifications are disabled by default.
# Set APP_MAIL_ENABLED=true and fill SMTP_USER / SMTP_PASS to enable them.
APP_MAIL_ENABLED=false
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
